<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ page_title }} — {{ shop.name }}</title>
  <meta name="description" content="{{ page_description | default: 'HANGR Multi Tier Steel Hanger — the perfect storage solution for your bangles, accessories, belts, hairbands & more. Smart. Stylish. Space-saving.' }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,700&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  {{ content_for_header }}
  <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
</head>
<body>

  <!-- URGENCY COUNTDOWN BAR -->
  <div class="top-urgency-bar">
    <span>🔥 SPECIAL FESTIVE SALE: Extra 10% OFF on Orders | Use Code: <strong>HANGR10</strong></span>
    <span>Offers Ends In: <span class="countdown-timer" id="timer">14:59</span></span>
  </div>

  <!-- ANNOUNCEMENT MARQUEE -->
  <div class="announcement-bar" id="announcement-bar">
    <div class="announcement-bar__track">
      <div class="announcement-bar__item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        FREE EXPRESS SHIPPING ACROSS INDIA
      </div>
      <div class="announcement-bar__item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
        CASH ON DELIVERY (COD) AVAILABLE
      </div>
      <div class="announcement-bar__item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
        7-DAY EASY REPLACEMENT GUARANTEE
      </div>
      <div class="announcement-bar__item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        FREE EXPRESS SHIPPING ACROSS INDIA
      </div>
    </div>
  </div>

  <!-- NAVIGATION -->
  <nav class="nav" id="main-nav">
    <div class="nav__inner">
      <a href="/" class="nav__logo">
        <span class="nav__logo-name">HANGR</span>
        <span class="nav__logo-tagline">Organize. Display. Simplify.</span>
      </a>
      <div class="nav__links" id="nav-links">
        <a href="/" class="nav__link nav__link--active">Home</a>
        <a href="#hero" class="nav__link">Shop Hanger</a>
        <a href="#comparison-section" class="nav__link">Why HANGR?</a>
        <a href="#reviews-section" class="nav__link">Customer Reviews</a>
        <a href="#faq-section" class="nav__link">FAQs</a>
      </div>
      <div class="nav__actions">
        <button class="nav__action-btn" aria-label="Cart" onclick="openCartDrawer()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
          <span class="nav__cart-badge">0</span>
        </button>
        <button class="nav__mobile-toggle" id="mobile-toggle" aria-label="Menu" onclick="document.getElementById('nav-links').classList.toggle('mobile-open')">
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
  </nav>

  <!-- MAIN CONTENT -->
  <main>
    {{ content_for_layout }}
  </main>

  <!-- TRUST BAR -->
  <section class="trust">
    <div class="trust__grid">
      <div class="trust__item">
        <div class="trust__item-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        </div>
        <div class="trust__item-text">
          <span class="trust__item-title">Free Express Shipping</span>
          <span class="trust__item-desc">On orders over ₹999</span>
        </div>
      </div>
      <div class="trust__item">
        <div class="trust__item-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
        </div>
        <div class="trust__item-text">
          <span class="trust__item-title">Cash on Delivery</span>
          <span class="trust__item-desc">100% Verified COD</span>
        </div>
      </div>
      <div class="trust__item">
        <div class="trust__item-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
        </div>
        <div class="trust__item-text">
          <span class="trust__item-title">Easy Replacement</span>
          <span class="trust__item-desc">7-Day Guarantee</span>
        </div>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="footer" id="footer">
    <div class="footer__inner">
      <div class="footer__brand">
        <div class="footer__brand-name">HANGR</div>
        <p class="footer__brand-desc">The smarter way to organize your accessories. Premium quality steel hangers designed for Indian households.</p>
      </div>
      <div class="footer__col">
        <div class="footer__col-title">Quick Links</div>
        <a href="/" class="footer__col-link">Home</a>
        <a href="#hero" class="footer__col-link">Shop</a>
        <a href="#reviews-section" class="footer__col-link">Reviews</a>
      </div>
      <div class="footer__col">
        <div class="footer__col-title">Support</div>
        <a href="#faq-section" class="footer__col-link">FAQs</a>
        <a href="#" class="footer__col-link">Shipping & COD</a>
      </div>
    </div>
    <div class="footer__bottom">
      <p class="footer__copyright">&copy; {{ 'now' | date: '%Y' }} HANGR. All rights reserved. Made with ♥ in India.</p>
    </div>
  </footer>

  <!-- MOBILE STICKY BUY BAR -->
  <div class="sticky-buy-bar" id="sticky-bar">
    <div class="sticky-buy-info">
      <span class="sticky-buy-title">HANGR Steel Hanger</span>
      <span class="sticky-buy-price">Multi-Tier Space Saver</span>
    </div>
    <button
      type="button"
      class="btn-sticky-buy"
      onclick="triggerShopifyBuyNow(event)"
    >
      BUY NOW
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </button>
  </div>

  <!-- ===== CUSTOM D2C CART DRAWER MODAL ===== -->
  <div class="cart-drawer-overlay" id="cart-drawer-modal">
    <div class="cart-drawer-content">
      <div class="cart-drawer-header">
        <h3>Shopping Cart (<span id="cart-drawer-count">0</span>)</h3>
        <span class="cart-drawer-close" onclick="closeCartDrawer()">&times;</span>
      </div>

      <div class="cart-drawer-body" id="cart-drawer-items">
        <!-- Dynamically rendered via /cart.js -->
      </div>

      <div class="cart-drawer-footer" id="cart-drawer-footer">
        <div class="cart-subtotal-row">
          <span>Subtotal</span>
          <span id="cart-subtotal-price">Rs. 0.00</span>
        </div>
        <p style="font-size: 0.75rem; color: var(--gray-600); margin-bottom: 12px; text-align: center;">Taxes & Free Shipping calculated at checkout</p>
        <a href="/checkout" class="btn-primary" style="width: 100%; justify-content: center; text-align: center; border-radius: 50px;">
          PROCEED TO CHECKOUT (COD AVAILABLE) →
        </a>
      </div>
    </div>
  </div>

  <script>
    function switchMainImage(thumb) {
      const main = document.getElementById('main-product-display');
      if (main && thumb) {
        main.src = thumb.src;
        document.querySelectorAll('.thumb-img').forEach(t => t.classList.remove('active'));
        thumb.classList.add('active');
      }
    }

    let duration = 14 * 60 + 59;
    const timerDisplay = document.getElementById('timer');
    setInterval(() => {
      let minutes = Math.floor(duration / 60);
      let seconds = duration % 60;
      seconds = seconds < 10 ? '0' + seconds : seconds;
      if (timerDisplay) timerDisplay.textContent = `${minutes}:${seconds}`;
      if (duration > 0) duration--;
    }, 1000);

    // CART DRAWER FUNCTIONS
    function openCartDrawer() {
      const modal = document.getElementById('cart-drawer-modal');
      if (modal) {
        modal.classList.add('active');
        renderCartDrawer();
      }
    }

    function closeCartDrawer() {
      const modal = document.getElementById('cart-drawer-modal');
      if (modal) modal.classList.remove('active');
    }

    function renderCartDrawer() {
      fetch('/cart.js')
        .then(r => r.json())
        .then(cart => {
          document.querySelectorAll('.nav__cart-badge').forEach(b => b.textContent = cart.item_count);
          const countEl = document.getElementById('cart-drawer-count');
          if (countEl) countEl.textContent = cart.item_count;

          const container = document.getElementById('cart-drawer-items');
          const footer = document.getElementById('cart-drawer-footer');

          if (!container) return;

          if (cart.item_count === 0) {
            container.innerHTML = `
              <div style="text-align: center; padding: 60px 20px; color: var(--gray-600);">
                <p style="font-size: 1.1rem; font-weight: 600; margin-bottom: 16px;">Your cart is empty.</p>
                <a href="#hero" onclick="closeCartDrawer()" class="btn-primary" style="font-size: 0.82rem; padding: 12px 24px;">Start Shopping</a>
              </div>
            `;
            if (footer) footer.style.display = 'none';
          } else {
            if (footer) footer.style.display = 'block';
            const subtotalEl = document.getElementById('cart-subtotal-price');
            if (subtotalEl) {
              subtotalEl.textContent = 'Rs. ' + (cart.total_price / 100).toFixed(2);
            }

            let html = '';
            cart.items.forEach((item) => {
              const itemKey = item.key || item.variant_id;
              html += `
                <div style="display: flex; gap: 14px; padding: 16px 0; border-bottom: 1px solid var(--gray-200); align-items: center;">
                  <img src="${item.image}" alt="${item.product_title}" style="width: 72px; height: 72px; object-fit: cover; border-radius: 10px; border: 1px solid var(--gray-200);">
                  <div style="flex: 1;">
                    <div style="font-weight: 700; font-size: 0.9rem; color: var(--dark);">${item.product_title}</div>
                    <div style="font-size: 0.78rem; color: var(--gray-600); margin: 2px 0;">${item.variant_title || ''}</div>
                    <div style="font-weight: 800; font-size: 0.9rem; color: var(--dark); margin-bottom: 6px;">Rs. ${(item.price / 100).toFixed(2)}</div>
                    <div class="cart-item-qty-picker">
                      <button type="button" class="cart-qty-btn" onclick="changeCartQuantity('${itemKey}', ${item.quantity - 1})">−</button>
                      <input type="number" class="cart-qty-input" value="${item.quantity}" min="1" onchange="changeCartQuantity('${itemKey}', this.value)">
                      <button type="button" class="cart-qty-btn" onclick="changeCartQuantity('${itemKey}', ${item.quantity + 1})">+</button>
                    </div>
                  </div>
                  <button onclick="changeCartQuantity('${itemKey}', 0)" title="Remove item" style="color: var(--red-accent); font-size: 1.3rem; cursor: pointer; padding: 4px; border:none; background:none;">&times;</button>
                </div>
              `;
            });
            container.innerHTML = html;
          }
        })
        .catch(err => {
          console.error("Cart fetch error:", err);
        });
    }

    function changeCartQuantity(id, quantity) {
      let qty = parseInt(quantity);
      if (isNaN(qty) || qty < 0) qty = 0;

      fetch('/cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: id, quantity: qty })
      })
      .then(r => r.json())
      .then(() => renderCartDrawer())
      .catch(err => console.error("Error updating cart quantity:", err));
    }

    function adjustProductQty(delta) {
      const input = document.getElementById('product-qty-input') || document.querySelector('input[name="quantity"]');
      if (input) {
        let current = parseInt(input.value) || 1;
        let next = current + delta;
        if (next < 1) next = 1;
        input.value = next;
      }
    }

    function validateProductQty(input) {
      let val = parseInt(input.value);
      if (isNaN(val) || val < 1) {
        input.value = 1;
      }
    }

    function handleBuyNow(e) {
      if (e) e.preventDefault();
      let selectedVariantId = '53853852500152';
      const checkedRadio = document.querySelector('input[name="id"]:checked');
      if (checkedRadio && checkedRadio.value) {
        selectedVariantId = checkedRadio.value;
      }
      const qtyInput = document.querySelector('#AddToCartForm input[name="quantity"]');
      const quantity = qtyInput ? (parseInt(qtyInput.value) || 1) : 1;
      window.location.href = '/cart/' + selectedVariantId + ':' + quantity;
    }

    function handleAddToCart(e) {
      if (e) e.preventDefault();
      let selectedVariantId = '53853852500152';
      const checkedRadio = document.querySelector('input[name="id"]:checked');
      if (checkedRadio && checkedRadio.value) {
        selectedVariantId = checkedRadio.value;
      }

      const qtyInput = document.querySelector('#AddToCartForm input[name="quantity"]');
      const quantity = qtyInput ? (parseInt(qtyInput.value) || 1) : 1;

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: [{ id: parseInt(selectedVariantId), quantity: quantity }] })
      })
      .then(res => res.json())
      .then(data => {
        openCartDrawer();
      })
      .catch(err => {
        const form = document.getElementById('AddToCartForm');
        if (form) form.submit();
      });
    }

    function triggerShopifyBuyNow(event) {
      handleBuyNow(event);
    }

    // Auto sync cart on initial page load
    document.addEventListener('DOMContentLoaded', function() {
      fetch('/cart.js')
        .then(r => r.json())
        .then(cart => {
          document.querySelectorAll('.nav__cart-badge').forEach(b => b.textContent = cart.item_count);
        });
    });

    window.addEventListener('scroll', () => {
      const stickyBar = document.getElementById('sticky-bar');
      if (stickyBar) {
        if (window.scrollY > 300) stickyBar.classList.add('active');
        else stickyBar.classList.remove('active');
      }
    });

    function initFaqs() {
      document.querySelectorAll('.faq-item').forEach(item => {
        item.addEventListener('click', function() {
          this.classList.toggle('active');
        });
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFaqs);
    } else {
      initFaqs();
    }
  </script>
</body>
</html>
