<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ page_title }} — {{ shop.name }}</title>
  <meta name="description" content="{{ page_description | default: 'HANGR Multi Tier Steel Hanger — the perfect storage solution for your bangles, accessories, belts, hairbands & more. Smart. Stylish. Space-saving.' }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,700&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <script type="module" src="https://cdn.shopify.com/storefront/web-components.js"></script>
  {{ content_for_header }}
  <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
</head>
<body>

  <!-- Shopify Store Config -->
  <shopify-store
    store-domain="https://nrqbvn-sy.myshopify.com"
    public-access-token="f4022f3801b4eeb396c11fa77dd5e082"
    country="IN"
    language="en"
  ></shopify-store>

  <!-- URGENCY COUNTDOWN BAR -->
  <div class="top-urgency-bar">
    <span>🔥 SPECIAL FESTIVE SALE: Extra 10% OFF on Orders | Use Code: <strong>HANGR10</strong></span>
    <span>Offers Ends In: <span class="countdown-timer" id="timer">14:59</span></span>
  </div>

  <!-- ANNOUNCEMENT MARQUEE -->
  <div class="announcement-bar" id="announcement-bar">
    <div class="announcement-bar__track">
      <div class="announcement-bar__item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        FREE EXPRESS SHIPPING ACROSS INDIA
      </div>
      <div class="announcement-bar__item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
        CASH ON DELIVERY (COD) AVAILABLE
      </div>
      <div class="announcement-bar__item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
        7-DAY EASY REPLACEMENT GUARANTEE
      </div>
      <div class="announcement-bar__item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        FREE EXPRESS SHIPPING ACROSS INDIA
      </div>
    </div>
  </div>

  <!-- NAVIGATION -->
  <nav class="nav" id="main-nav">
    <div class="nav__inner">
      <a href="/" class="nav__logo">
        <span class="nav__logo-name">HANGR</span>
        <span class="nav__logo-tagline">Organize. Display. Simplify.</span>
      </a>
      <div class="nav__links" id="nav-links">
        <a href="/" class="nav__link nav__link--active">Home</a>
        <a href="#product-section" class="nav__link">Shop Hanger</a>
        <a href="#comparison-section" class="nav__link">Why HANGR?</a>
        <a href="#reviews-section" class="nav__link">Customer Reviews</a>
        <a href="#faq-section" class="nav__link">FAQs</a>
      </div>
      <div class="nav__actions">
        <button class="nav__action-btn" aria-label="Cart" onclick="document.getElementById('main-cart').showModal()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
          <span class="nav__cart-badge">0</span>
        </button>
        <button class="nav__mobile-toggle" id="mobile-toggle" aria-label="Menu" onclick="document.getElementById('nav-links').classList.toggle('mobile-open')">
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
  </nav>

  <!-- MAIN CONTENT -->
  <main>
    {{ content_for_layout }}
  </main>

  <!-- TRUST BAR -->
  <section class="trust">
    <div class="trust__grid">
      <div class="trust__item">
        <div class="trust__item-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        </div>
        <div class="trust__item-text">
          <span class="trust__item-title">Free Express Shipping</span>
          <span class="trust__item-desc">On orders over ₹999</span>
        </div>
      </div>
      <div class="trust__item">
        <div class="trust__item-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
        </div>
        <div class="trust__item-text">
          <span class="trust__item-title">Cash on Delivery</span>
          <span class="trust__item-desc">100% Verified COD</span>
        </div>
      </div>
      <div class="trust__item">
        <div class="trust__item-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
        </div>
        <div class="trust__item-text">
          <span class="trust__item-title">Easy Replacement</span>
          <span class="trust__item-desc">7-Day Guarantee</span>
        </div>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="footer" id="footer">
    <div class="footer__inner">
      <div class="footer__brand">
        <div class="footer__brand-name">HANGR</div>
        <p class="footer__brand-desc">The smarter way to organize your accessories. Premium quality steel hangers designed for Indian households.</p>
      </div>
      <div class="footer__col">
        <div class="footer__col-title">Quick Links</div>
        <a href="/" class="footer__col-link">Home</a>
        <a href="#product-section" class="footer__col-link">Shop</a>
        <a href="#reviews-section" class="footer__col-link">Reviews</a>
      </div>
      <div class="footer__col">
        <div class="footer__col-title">Support</div>
        <a href="#faq-section" class="footer__col-link">FAQs</a>
        <a href="#" class="footer__col-link">Shipping & COD</a>
      </div>
    </div>
    <div class="footer__bottom">
      <p class="footer__copyright">&copy; {{ 'now' | date: '%Y' }} HANGR. All rights reserved. Made with ♥ in India.</p>
    </div>
  </footer>

  <!-- MOBILE STICKY BUY BAR -->
  <div class="sticky-buy-bar" id="sticky-bar">
    <div class="sticky-buy-info">
      <span class="sticky-buy-title">HANGR Steel Hanger</span>
      <span class="sticky-buy-price">Multi-Tier Space Saver</span>
    </div>
    <button
      type="button"
      class="btn-sticky-buy"
      onclick="triggerShopifyBuyNow(event)"
    >
      BUY NOW
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </button>
  </div>

  <!-- SHOPIFY CART -->
  <shopify-cart id="main-cart">
    <div slot="checkout-button">Proceed to Checkout</div>
    <div slot="empty">Your cart is empty. Start shopping!</div>
  </shopify-cart>

  <script>
    let duration = 14 * 60 + 59;
    const timerDisplay = document.getElementById('timer');
    setInterval(() => {
      let minutes = Math.floor(duration / 60);
      let seconds = duration % 60;
      seconds = seconds < 10 ? '0' + seconds : seconds;
      if (timerDisplay) timerDisplay.textContent = `${minutes}:${seconds}`;
      if (duration > 0) duration--;
    }, 1000);

    function triggerShopifyBuyNow(event) {
      const buyBtn = document.querySelector('.product-card__buy-btn');
      if (buyBtn && !buyBtn.disabled) {
        buyBtn.click();
      } else {
        const store = document.querySelector('shopify-store');
        if (store && store.buyNow) {
          store.buyNow(event);
        } else {
          document.getElementById('product-card').scrollIntoView({ behavior: 'smooth' });
        }
      }
    }

    window.addEventListener('scroll', () => {
      const stickyBar = document.getElementById('sticky-bar');
      if (stickyBar) {
        if (window.scrollY > 400) stickyBar.classList.add('active');
        else stickyBar.classList.remove('active');
      }
    });
  </script>
</body>
</html>
