  </section>

  <!-- FOOTER -->
  <footer class="footer" id="footer">
    <div class="footer__inner">
      <div class="footer__brand">
        <div class="footer__brand-name">HANGR</div>
        <p class="footer__brand-desc">The smarter way to organize your accessories. Premium quality steel hangers designed for Indian households.</p>
      </div>
      <div class="footer__col">
        <div class="footer__col-title">Quick Links</div>
        <a href="/" class="footer__col-link">Home</a>
        <a href="#hero" class="footer__col-link">Shop Hanger</a>
        <a href="#reviews-section" class="footer__col-link">Customer Reviews</a>
        <a href="#faq-section" class="footer__col-link">FAQs</a>
      </div>
      <div class="footer__col">
        <div class="footer__col-title">Policies & Legal</div>
        <a href="javascript:void(0)" onclick="openPolicyModal('terms')" class="footer__col-link">Terms & Conditions</a>
        <a href="javascript:void(0)" onclick="openPolicyModal('shipping')" class="footer__col-link">Shipping Policy</a>
        <a href="javascript:void(0)" onclick="openPolicyModal('return')" class="footer__col-link">Return & Replacement Policy</a>
        <a href="javascript:void(0)" onclick="openPolicyModal('privacy')" class="footer__col-link">Privacy Policy</a>
      </div>
    </div>
    <div class="footer__bottom">
      <p class="footer__copyright">&copy; {{ 'now' | date: '%Y' }} HANGR. All rights reserved. Made with ♥ in India.</p>
      <div class="footer__policy-bar" style="display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; margin-top: 8px; font-size: 0.78rem; opacity: 0.85;">
        <a href="javascript:void(0)" onclick="openPolicyModal('terms')" style="color: inherit; text-decoration: underline;">Terms & Conditions</a>
        <span>•</span>
        <a href="javascript:void(0)" onclick="openPolicyModal('shipping')" style="color: inherit; text-decoration: underline;">Shipping Policy</a>
        <span>•</span>
        <a href="javascript:void(0)" onclick="openPolicyModal('return')" style="color: inherit; text-decoration: underline;">Return Policy</a>
        <span>•</span>
        <a href="javascript:void(0)" onclick="openPolicyModal('privacy')" style="color: inherit; text-decoration: underline;">Privacy Policy</a>
      </div>
    </div>
  </footer>

  <!-- MOBILE STICKY BUY BAR -->
  <div class="sticky-buy-bar" id="sticky-bar">
    <div class="sticky-buy-info">
      <span class="sticky-buy-title">HANGR Steel Hanger</span>
      <span class="sticky-buy-price">Multi-Tier Space Saver</span>
    </div>
    <button
      type="button"
      class="btn-sticky-buy"
      onclick="triggerShopifyBuyNow(event)"
    >
      BUY NOW
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </button>
  </div>

  <!-- ===== CUSTOM D2C CART DRAWER MODAL ===== -->
  <div class="cart-drawer-overlay" id="cart-drawer-modal">
    <div class="cart-drawer-content">
      <div class="cart-drawer-header">
        <h3>Shopping Cart (<span id="cart-drawer-count">0</span>)</h3>
        <span class="cart-drawer-close" onclick="closeCartDrawer()">&times;</span>
      </div>

      <div class="cart-drawer-body" id="cart-drawer-items">
        <!-- Dynamically rendered via /cart.js -->
      </div>

      <div class="cart-drawer-footer" id="cart-drawer-footer">
        <div class="cart-subtotal-row">
          <span>Subtotal</span>
          <span id="cart-subtotal-price">Rs. 0.00</span>
        </div>
        <p style="font-size: 0.75rem; color: var(--gray-600); margin-bottom: 12px; text-align: center;">Taxes & Free Shipping calculated at checkout</p>
        <a href="/checkout" class="btn-primary btn-checkout" style="width: 100%; justify-content: center; text-align: center; border-radius: 50px;">
          PROCEED TO CHECKOUT →
        </a>
      </div>
    </div>
  </div>

  <!-- ===== SELECT SIZE / LAYERS MODAL POPUP ===== -->
  <div class="variant-modal-overlay" id="variant-modal" onclick="if(event.target===this) closeVariantModal()">
    <div class="variant-modal-content">
      <div class="variant-modal-header">
        <div class="variant-modal-title-wrap">
          <h3 class="variant-modal-title">SELECT SIZE / LAYERS</h3>
          <p class="variant-modal-subtitle">Choose an option to continue</p>
        </div>
        <button type="button" class="variant-modal-close" onclick="closeVariantModal()" aria-label="Close">&times;</button>
      </div>

      <div class="variant-modal-body">
        <div class="variant-modal-grid" id="variant-modal-grid">
          <!-- Dynamically populated from on-page variant cards -->
        </div>
      </div>

      <div class="variant-modal-footer">
        <button type="button" class="btn-primary variant-modal-action-btn" id="variant-modal-confirm-btn" onclick="confirmVariantModalAction()">
          CONTINUE TO ADD TO CART →
        </button>
      </div>
    </div>
  </div>

  <!-- ===== WRITE A REVIEW MODAL ===== -->
  <div class="review-modal-overlay" id="review-modal">
    <div class="review-modal-content">
      <div class="review-modal-header">
        <h3>Write a Customer Review</h3>
        <span class="review-modal-close" onclick="closeReviewModal()">&times;</span>
      </div>
      <form id="review-form" onsubmit="submitReview(event)">
        <div class="review-form-group">
          <label>Your Overall Rating</label>
          <div class="star-rating-picker" id="star-picker">
            <span class="star selected" data-value="1">★</span>
            <span class="star selected" data-value="2">★</span>
            <span class="star selected" data-value="3">★</span>
            <span class="star selected" data-value="4">★</span>
            <span class="star selected" data-value="5">★</span>
          </div>
          <input type="hidden" id="review-rating-val" value="5">
        </div>

        <div class="review-form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
          <div class="review-form-group">
            <label for="review-name">Your Name</label>
            <input type="text" id="review-name" required placeholder="e.g. Sunita Agarwal">
          </div>
          <div class="review-form-group">
            <label for="review-city">City & State</label>
            <input type="text" id="review-city" required placeholder="e.g. Jaipur, Rajasthan">
          </div>
        </div>

        <div class="review-form-group">
          <label for="review-headline">Review Headline</label>
          <input type="text" id="review-headline" required placeholder="e.g. Absolutely loved this organizer!">
        </div>

        <div class="review-form-group">
          <label for="review-body">Review Description</label>
          <textarea id="review-body" rows="4" required placeholder="Share details about the quality, space saving, or durability..."></textarea>
        </div>

        <div class="review-form-group">
          <label for="review-photo">Add Product Photo (Optional)</label>
          <input type="file" id="review-photo" accept="image/*" onchange="previewReviewPhoto(event)">
          <img id="photo-preview-img" src="" alt="Photo preview" style="display: none; width: 80px; height: 80px; object-fit: cover; border-radius: 8px; margin-top: 8px; border: 1px solid var(--gray-200);">
        </div>

        <button type="submit" class="btn-primary" style="width: 100%; justify-content: center; margin-top: 10px; border-radius: 50px;">
          SUBMIT REVIEW NOW
        </button>
      </form>
    </div>
  </div>

  <!-- ===== STORE POLICIES MODAL ===== -->
  <div class="policy-modal-overlay" id="policy-modal">
    <div class="policy-modal-content">
      <div class="policy-modal-header">
        <h3 id="policy-modal-title">Store Policy</h3>
        <span class="policy-modal-close" onclick="closePolicyModal()">&times;</span>
      </div>
      <div class="policy-modal-body" id="policy-modal-body">
        <!-- Dynamically injected policy content -->
      </div>
    </div>
  </div>

  <script>
    function switchMainImage(thumb) {
      const main = document.getElementById('main-product-display');
      if (!main || !thumb) return;

      let targetSrc = thumb.getAttribute('data-full-src');
      if (!targetSrc || targetSrc === '') {
        targetSrc = thumb.src.replace('_150x', '_1600x').replace('_300x', '_1600x').replace(/width=\d+/, 'width=1600');
      }

      main.style.opacity = '0.5';
      const imgPreloader = new Image();
      imgPreloader.onload = function() {
        main.src = targetSrc;
        main.style.opacity = '1';
      };
      imgPreloader.onerror = function() {
        main.src = targetSrc;
        main.style.opacity = '1';
      };
      imgPreloader.src = targetSrc;

      document.querySelectorAll('.thumb-img').forEach(t => t.classList.remove('active'));
      thumb.classList.add('active');

      if (typeof thumb.scrollIntoView === 'function') {
        thumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
      }
    }
    window.switchMainImage = switchMainImage;

    function prevGalleryImage(e) {
      if (e && e.cancelable && typeof e.preventDefault === 'function') {
        try { e.preventDefault(); } catch(err) {}
      }
      if (e && typeof e.stopPropagation === 'function') {
        try { e.stopPropagation(); } catch(err) {}
      }
      const thumbs = Array.from(document.querySelectorAll('.thumb-img'));
      if (!thumbs.length) return;
      let currentIndex = thumbs.findIndex(t => t.classList.contains('active'));
      if (currentIndex <= 0) currentIndex = thumbs.length;
      switchMainImage(thumbs[currentIndex - 1]);
    }
    window.prevGalleryImage = prevGalleryImage;

    function nextGalleryImage(e) {
      if (e && e.cancelable && typeof e.preventDefault === 'function') {
        try { e.preventDefault(); } catch(err) {}
      }
      if (e && typeof e.stopPropagation === 'function') {
        try { e.stopPropagation(); } catch(err) {}
      }
      const thumbs = Array.from(document.querySelectorAll('.thumb-img'));
      if (!thumbs.length) return;
      let currentIndex = thumbs.findIndex(t => t.classList.contains('active'));
      if (currentIndex === -1 || currentIndex >= thumbs.length - 1) {
        switchMainImage(thumbs[0]);
      } else {
        switchMainImage(thumbs[currentIndex + 1]);
      }
    }
    window.nextGalleryImage = nextGalleryImage;

    let duration = 14 * 60 + 59;
    const timerDisplay = document.getElementById('timer');
    setInterval(() => {
      let minutes = Math.floor(duration / 60);
      let seconds = duration % 60;
      seconds = seconds < 10 ? '0' + seconds : seconds;
      if (timerDisplay) timerDisplay.textContent = `${minutes}:${seconds}`;
      if (duration > 0) duration--;
    }, 1000);

    // CART DRAWER FUNCTIONS
    function openCartDrawer() {
      const modal = document.getElementById('cart-drawer-modal');
      if (modal) {
        modal.classList.add('active');
        renderCartDrawer();
      }
    }

    function closeCartDrawer() {
      const modal = document.getElementById('cart-drawer-modal');
      if (modal) modal.classList.remove('active');
    }

    function renderCartDrawer() {
      fetch('/cart.js')
        .then(r => r.json())
        .then(cart => {
          document.querySelectorAll('.nav__cart-badge').forEach(b => b.textContent = cart.item_count);
          const countEl = document.getElementById('cart-drawer-count');
          if (countEl) countEl.textContent = cart.item_count;

          const container = document.getElementById('cart-drawer-items');
          const footer = document.getElementById('cart-drawer-footer');

          if (!container) return;

          if (cart.item_count === 0) {
            container.innerHTML = `
              <div style="text-align: center; padding: 60px 20px; color: var(--gray-600);">
                <p style="font-size: 1.1rem; font-weight: 600; margin-bottom: 16px;">Your cart is empty.</p>
                <a href="#hero" onclick="closeCartDrawer()" class="btn-primary" style="font-size: 0.82rem; padding: 12px 24px;">Start Shopping</a>
              </div>
            `;
            if (footer) footer.style.display = 'none';
          } else {
            if (footer) footer.style.display = 'block';
            const subtotalEl = document.getElementById('cart-subtotal-price');
            if (subtotalEl) {
              subtotalEl.textContent = 'Rs. ' + (cart.total_price / 100).toFixed(2);
            }

            let html = '';
            cart.items.forEach((item) => {
              const itemKey = item.key || item.variant_id;
              html += `
                <div style="display: flex; gap: 14px; padding: 16px 0; border-bottom: 1px solid var(--gray-200); align-items: center;">
                  <img src="${item.image}" alt="${item.product_title}" style="width: 72px; height: 72px; object-fit: cover; border-radius: 10px; border: 1px solid var(--gray-200);">
                  <div style="flex: 1;">
                    <div style="font-weight: 700; font-size: 0.9rem; color: var(--dark);">${item.product_title}</div>
                    <div style="font-size: 0.78rem; color: var(--gray-600); margin: 2px 0;">${item.variant_title || ''}</div>
                    <div style="font-weight: 800; font-size: 0.9rem; color: var(--dark); margin-bottom: 6px;">Rs. ${(item.price / 100).toFixed(2)}</div>
                    <div class="cart-item-qty-picker">
                      <button type="button" class="cart-qty-btn" onclick="changeCartQuantity('${itemKey}', ${item.quantity - 1})">−</button>
                      <input type="number" class="cart-qty-input" value="${item.quantity}" min="1" onchange="changeCartQuantity('${itemKey}', this.value)">
                      <button type="button" class="cart-qty-btn" onclick="changeCartQuantity('${itemKey}', ${item.quantity + 1})">+</button>
                    </div>
                  </div>
                  <button onclick="changeCartQuantity('${itemKey}', 0)" title="Remove item" style="color: var(--red-accent); font-size: 1.3rem; cursor: pointer; padding: 4px; border:none; background:none;">&times;</button>
                </div>
              `;
            });
            container.innerHTML = html;
          }
        })
        .catch(err => {
          console.error("Cart fetch error:", err);
        });
    }

    function changeCartQuantity(id, quantity) {
      let qty = parseInt(quantity);
      if (isNaN(qty) || qty < 0) qty = 0;

      fetch('/cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: id, quantity: qty })
      })
      .then(r => r.json())
      .then(() => renderCartDrawer())
      .catch(err => console.error("Error updating cart quantity:", err));
    }

    function adjustProductQty(delta) {
      const input = document.getElementById('product-qty-input') || document.querySelector('input[name="quantity"]');
      if (input) {
        let current = parseInt(input.value) || 1;
        let next = current + delta;
        if (next < 1) next = 1;
        input.value = next;
      }
    }

    function validateProductQty(input) {
      let val = parseInt(input.value);
      if (isNaN(val) || val < 1) {
        input.value = 1;
      }
    }

    let pendingVariantAction = null;

    function populateVariantModalGrid() {
      const grid = document.getElementById('variant-modal-grid');
      if (!grid) return;

      const pageCards = document.querySelectorAll('#AddToCartForm .variant-option-card');
      if (pageCards.length > 0) {
        grid.innerHTML = '';
        pageCards.forEach(card => {
          const radio = card.querySelector('input[name="id"]');
          const nameEl = card.querySelector('.variant-option-name');
          const priceEl = card.querySelector('.variant-option-price');
          if (!radio) return;

          const variantId = radio.value;
          const title = nameEl ? nameEl.textContent.trim() : (radio.dataset.title || '');
          const price = priceEl ? priceEl.textContent.trim() : (radio.dataset.price || '');
          const isSelected = radio.checked;

          const popupCard = document.createElement('div');
          popupCard.className = 'variant-popup-card' + (isSelected ? ' selected' : '');
          popupCard.setAttribute('data-variant-id', variantId);
          popupCard.onclick = function() { selectVariantFromPopup(variantId); };
          popupCard.innerHTML = `
            <input type="radio" name="popup_variant_id" value="${variantId}" class="variant-popup-radio" ${isSelected ? 'checked' : ''}>
            <div class="variant-popup-info">
              <span class="variant-popup-title">${title}</span>
              <span class="variant-popup-price">${price}</span>
            </div>
          `;
          grid.appendChild(popupCard);
        });
      } else {
        // Fallback options matching 4 standard hanger variants
        const fallbackVariants = [
          { id: '53853852500152', title: '3 layer (Pack of 2) —', price: 'Rs. 499.00' },
          { id: '53853852532920', title: '4 layer (Pack of 2) —', price: 'Rs. 579.00' },
          { id: '53853852565688', title: '6 layer (Pack of 2) —', price: 'Rs. 749.00' },
          { id: '53853852598456', title: '8 layer (Pack of 2) —', price: 'Rs. 849.00' }
        ];
        const checkedPage = document.querySelector('#AddToCartForm input[name="id"]:checked');
        const selectedVal = checkedPage ? checkedPage.value : null;

        grid.innerHTML = '';
        fallbackVariants.forEach(v => {
          const isSelected = selectedVal === v.id;
          const popupCard = document.createElement('div');
          popupCard.className = 'variant-popup-card' + (isSelected ? ' selected' : '');
          popupCard.setAttribute('data-variant-id', v.id);
          popupCard.onclick = function() { selectVariantFromPopup(v.id); };
          popupCard.innerHTML = `
            <input type="radio" name="popup_variant_id" value="${v.id}" class="variant-popup-radio" ${isSelected ? 'checked' : ''}>
            <div class="variant-popup-info">
              <span class="variant-popup-title">${v.title}</span>
              <span class="variant-popup-price">${v.price}</span>
            </div>
          `;
          grid.appendChild(popupCard);
        });
      }
    }

    function openVariantModal(action) {
      pendingVariantAction = action || 'cart';
      populateVariantModalGrid();
      const modal = document.getElementById('variant-modal');
      const confirmBtn = document.getElementById('variant-modal-confirm-btn');
      if (confirmBtn) {
        if (pendingVariantAction === 'buy') {
          confirmBtn.innerHTML = 'BUY NOW (CASH ON DELIVERY) →';
          confirmBtn.style.background = 'var(--emerald, #059669)';
        } else {
          confirmBtn.innerHTML = 'CONTINUE TO ADD TO CART →';
          confirmBtn.style.background = 'var(--dark, #111827)';
        }
      }
      syncPopupVariantSelection();
      if (modal) {
        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
    }

    function closeVariantModal() {
      const modal = document.getElementById('variant-modal');
      if (modal) {
        modal.classList.remove('active');
        document.body.style.overflow = '';
      }
    }

    function selectVariantFromPopup(variantId) {
      const pageRadios = document.querySelectorAll('#AddToCartForm input[name="id"]');
      let matchedRadio = null;
      pageRadios.forEach(radio => {
        if (radio.value === variantId) {
          radio.checked = true;
          matchedRadio = radio;
        } else {
          radio.checked = false;
        }
      });

      if (matchedRadio) {
        updateVariantSelection(matchedRadio);
      }

      syncPopupVariantSelection();
    }

    function syncPopupVariantSelection() {
      const checkedPageRadio = document.querySelector('#AddToCartForm input[name="id"]:checked');
      const selectedVal = checkedPageRadio ? checkedPageRadio.value : null;

      document.querySelectorAll('.variant-popup-card').forEach(card => {
        const radio = card.querySelector('input[type="radio"]');
        if (radio) {
          if (selectedVal && radio.value === selectedVal) {
            radio.checked = true;
            card.classList.add('selected');
          } else {
            radio.checked = false;
            card.classList.remove('selected');
          }
        }
      });
    }

    function confirmVariantModalAction() {
      const checkedRadio = document.querySelector('input[name="id"]:checked');
      if (!checkedRadio || !checkedRadio.value) {
        document.querySelectorAll('.variant-popup-card').forEach(card => {
          card.style.borderColor = '#EF4444';
          setTimeout(() => {
            if (!card.classList.contains('selected')) {
              card.style.borderColor = '';
            }
          }, 1000);
        });
        return;
      }

      closeVariantModal();

      if (pendingVariantAction === 'buy') {
        handleBuyNow();
      } else {
        handleAddToCart();
      }
    }

    function handleBuyNow(e) {
      if (e) e.preventDefault();
      const checkedRadio = document.querySelector('input[name="id"]:checked');
      if (!checkedRadio || !checkedRadio.value) {
        openVariantModal('buy');
        return;
      }
      const selectedVariantId = checkedRadio.value;
      const qtyInput = document.querySelector('#AddToCartForm input[name="quantity"]');
      const quantity = qtyInput ? (parseInt(qtyInput.value) || 1) : 1;
      window.location.href = '/cart/' + selectedVariantId + ':' + quantity;
    }

    function handleAddToCart(e) {
      if (e) e.preventDefault();
      const checkedRadio = document.querySelector('input[name="id"]:checked');
      if (!checkedRadio || !checkedRadio.value) {
        openVariantModal('cart');
        return;
      }
      const selectedVariantId = checkedRadio.value;

      const qtyInput = document.querySelector('#AddToCartForm input[name="quantity"]');
      const quantity = qtyInput ? (parseInt(qtyInput.value) || 1) : 1;

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: [{ id: parseInt(selectedVariantId), quantity: quantity }] })
      })
      .then(res => res.json())
      .then(data => {
        openCartDrawer();
      })
      .catch(err => {
        const form = document.getElementById('AddToCartForm');
        if (form) form.submit();
      });
    }

    function triggerShopifyBuyNow(event) {
      handleBuyNow(event);
    }

    function updateVariantSelection(radio) {
      if (!radio) return;
      const priceDisplay = document.getElementById('product-price-display');
      const mrpDisplay = document.querySelector('.price-mrp');
      const priceAttr = radio.getAttribute('data-price');
      const mrpAttr = radio.getAttribute('data-mrp');

      if (priceDisplay && priceAttr) {
        priceDisplay.textContent = priceAttr;
      }
      if (mrpDisplay && mrpAttr) {
        mrpDisplay.textContent = mrpAttr.startsWith('M.R.P.') ? mrpAttr : ('M.R.P.: ' + mrpAttr);
      }

      document.querySelectorAll('.variant-option-card, .variant-option-label').forEach(label => {
        const input = label.querySelector('input[type="radio"]');
        if (input && input.checked) {
          label.classList.add('selected');
          label.classList.add('active');
        } else {
          label.classList.remove('selected');
          label.classList.remove('active');
        }
      });

      syncPopupVariantSelection();
    }

    function openReviewModal() {
      const modal = document.getElementById('review-modal');
      if (modal) modal.classList.add('active');
    }

    function closeReviewModal() {
      const modal = document.getElementById('review-modal');
      if (modal) modal.classList.remove('active');
    }

    let selectedRating = 5;
    let reviewPhotoData = null;

    function previewReviewPhoto(event) {
      const file = event.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = function(e) {
          reviewPhotoData = e.target.result;
          const previewImg = document.getElementById('photo-preview-img');
          if (previewImg) {
            previewImg.src = reviewPhotoData;
            previewImg.style.display = 'block';
          }
        };
        reader.readAsDataURL(file);
      }
    }

    function submitReview(e) {
      if (e) e.preventDefault();
      const name = document.getElementById('review-name')?.value || 'Anonymous';
      const city = document.getElementById('review-city')?.value || 'India';
      const headline = document.getElementById('review-headline')?.value || 'Great product!';
      const body = document.getElementById('review-body')?.value || '';
      const ratingStars = '★'.repeat(selectedRating) + '☆'.repeat(5 - selectedRating);
      const initials = name.split(' ').map(n => n[0]).join('').toUpperCase().substring(0, 2) || 'RV';

      const reviewCard = document.createElement('div');
      reviewCard.className = 'review-card fade-in visible';
      reviewCard.innerHTML = `
        <div class="review-card__user">
          <div class="review-card__avatar">${initials}</div>
          <div class="review-card__meta">
            <span class="review-card__name">${name}</span>
            <span class="review-card__location">${city}</span>
          </div>
        </div>
        <div class="verified-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
          Verified Buyer (India)
        </div>
        <div class="review-card__rating">${ratingStars}</div>
        <div class="review-card__title">${headline}</div>
        <div class="review-card__text">${body}</div>
        ${reviewPhotoData ? `<div class="review-card__photo"><img src="${reviewPhotoData}" alt="User photo"></div>` : ''}
        <div class="review-card__footer">
          <span>Just now</span>
          <button class="helpful-btn">👍 Helpful (1)</button>
        </div>
      `;

      const grid = document.getElementById('reviews-grid');
      const emptyNotice = document.getElementById('empty-reviews-notice');
      if (emptyNotice) emptyNotice.remove();
      if (grid) {
        grid.insertBefore(reviewCard, grid.firstChild);
      }

      closeReviewModal();
      const form = document.getElementById('review-form');
      if (form) form.reset();
      const previewImg = document.getElementById('photo-preview-img');
      if (previewImg) previewImg.style.display = 'none';
      reviewPhotoData = null;

      alert('Thank you! Your review has been submitted successfully.');
    }

    function initFaqs() {
      document.querySelectorAll('.faq-item').forEach(item => {
        item.addEventListener('click', function() {
          this.classList.toggle('active');
        });
      });
    }

    function openPolicyModal(type) {
      const modal = document.getElementById('policy-modal');
      const title = document.getElementById('policy-modal-title');
      const body = document.getElementById('policy-modal-body');
      if (!modal || !title || !body) return;

      if (type === 'return') {
        title.textContent = 'Return & Replacement Policy';
        body.innerHTML = `
          <div style="background: #FEF2F2; border-left: 4px solid #EF4444; padding: 12px 16px; border-radius: 8px; margin-bottom: 16px; color: #991B1B; font-weight: 600; font-size: 0.88rem;">
            ⚠️ IMPORTANT: Returns are allowed ONLY on damaged/defective goods and require a continuous unboxing video proof submitted within 3 days of delivery.
          </div>
          <h4>1. Damage-Only Return & Replacement Policy</h4>
          <p>Every HANGR steel organizer undergoes strict quality control. Returns or replacements are accepted <strong>ONLY if you receive a damaged, defective, or incorrect item</strong> during delivery.</p>
          <h4>2. Mandatory Unboxing Video Proof</h4>
          <p>To qualify for a replacement, customers <strong>MUST provide an unedited, continuous unboxing video</strong> showing the parcel package, shipping label, and the defect/damage clearly.</p>
          <h4>3. 3-Day Reporting Deadline</h4>
          <p>All claims along with the unboxing video proof <strong>MUST be submitted within 3 days (72 hours)</strong> from the time of delivery date to support@hangr.in or our WhatsApp support.</p>
          <h4>4. Free Replacement Dispatch</h4>
          <p>Upon verification of your unboxing video proof, a brand new replacement pack of hangers will be dispatched to your doorstep completely free of charge.</p>
          <h4>5. Non-Returnable Conditions</h4>
          <p>Claims raised after 3 days, claims submitted without unboxing video proof, or return requests due to personal preference/change of mind are strictly non-eligible.</p>
        `;
      } else if (type === 'shipping') {
        title.textContent = 'Shipping & Delivery Policy';
        body.innerHTML = `
          <h4>1. Free Express Shipping</h4>
          <p>We provide Free Express Shipping across India on all orders over ₹999.</p>
          <h4>2. Order Processing & Dispatch</h4>
          <p>Orders are processed and dispatched within 24 to 48 business hours after order placement.</p>
          <h4>3. Estimated Delivery Timeline</h4>
          <p>Metro Cities: 2 to 4 business days. Rest of India: 4 to 6 business days across 19,000+ pincodes.</p>
          <h4>4. Cash on Delivery (COD)</h4>
          <p>100% verified Cash on Delivery is available nationwide.</p>
        `;
      } else if (type === 'terms') {
        title.textContent = 'Terms & Conditions';
        body.innerHTML = `
          <h4>1. Acceptance of Terms</h4>
          <p>By accessing or placing an order on HANGR, you agree to these Terms & Conditions.</p>
          <h4>2. Pack of 2 Product Guarantee</h4>
          <p>Product specifications are accurate as shown. Every hanger variant option on HANGR is delivered as a <strong>Pack of 2</strong> units.</p>
          <h4>3. Pricing & Payments</h4>
          <p>All prices are in Indian Rupees (INR) inclusive of GST. Payments can be made via COD, UPI, or Cards.</p>
        `;
      } else if (type === 'privacy') {
        title.textContent = 'Privacy Policy';
        body.innerHTML = `
          <h4>1. Information Collection & Use</h4>
          <p>We collect your name, shipping address, email, and mobile number solely to fulfill orders and send tracking updates.</p>
          <h4>2. Data Security</h4>
          <p>Your details are protected using 256-bit SSL encryption. We do NOT sell or share customer data with third-party marketing companies.</p>
        `;
      }

      modal.classList.add('active');
    }

    function closePolicyModal() {
      const modal = document.getElementById('policy-modal');
      if (modal) modal.classList.remove('active');
    }

    function initStarRating() {
      const stars = document.querySelectorAll('#star-picker .star');
      stars.forEach(star => {
        star.addEventListener('click', function() {
          selectedRating = parseInt(this.getAttribute('data-value')) || 5;
          const ratingValEl = document.getElementById('review-rating-val');
          if (ratingValEl) ratingValEl.value = selectedRating;
          stars.forEach((s, idx) => {
            if (idx < selectedRating) s.classList.add('selected');
            else s.classList.remove('selected');
          });
        });
      });
    }

    document.addEventListener('DOMContentLoaded', function() {
      fetch('/cart.js')
        .then(r => r.json())
        .then(cart => {
          document.querySelectorAll('.nav__cart-badge').forEach(b => b.textContent = cart.item_count);
        });

      const checkedRadio = document.querySelector('input[name="id"]:checked');
      if (checkedRadio) {
        updateVariantSelection(checkedRadio);
      }

      initStarRating();

      // Mobile Touch Swipe Gesture Support for Product Gallery
      const galleryWrapper = document.getElementById('gallery-main-wrapper');
      if (galleryWrapper) {
        let touchStartX = 0;
        let touchEndX = 0;
        galleryWrapper.addEventListener('touchstart', function(e) {
          touchStartX = e.changedTouches[0].screenX;
        }, { passive: true });

        galleryWrapper.addEventListener('touchend', function(e) {
          touchEndX = e.changedTouches[0].screenX;
          const diff = touchStartX - touchEndX;
          if (Math.abs(diff) > 35) {
            if (diff > 0) {
              nextGalleryImage();
            } else {
              prevGalleryImage();
            }
          }
        }, { passive: true });
      }

      // Attach Explicit Handlers for Prev/Next Arrows and Thumbnails
      const prevBtn = document.querySelector('.gallery-nav-prev');
      const nextBtn = document.querySelector('.gallery-nav-next');

      if (prevBtn) {
        prevBtn.addEventListener('click', prevGalleryImage);
        prevBtn.addEventListener('touchend', function(e) {
          if (e.cancelable) e.preventDefault();
          prevGalleryImage(e);
        }, { passive: false });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', nextGalleryImage);
        nextBtn.addEventListener('touchend', function(e) {
          if (e.cancelable) e.preventDefault();
          nextGalleryImage(e);
        }, { passive: false });
      }

      document.querySelectorAll('.thumb-img').forEach(thumb => {
        thumb.addEventListener('click', function(e) {
          switchMainImage(this);
        });
        thumb.addEventListener('touchend', function(e) {
          switchMainImage(this);
        }, { passive: true });
      });
    });

    window.addEventListener('scroll', () => {
      const stickyBar = document.getElementById('sticky-bar');
      if (stickyBar) {
        if (window.scrollY > 300) stickyBar.classList.add('active');
        else stickyBar.classList.remove('active');
      }
    });

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFaqs);
    } else {
      initFaqs();
    }
    /* ===== SMOOTH MARQUEE (requestAnimationFrame) ===== */
    (function() {
      var track = document.querySelector('.announcement-bar__track');
      if (!track) return;

      var speed = 60; // pixels per second
      var offset = 0;
      var lastTime = 0;
      var oneThird = 0;
      var running = true;

      function measure() {
        oneThird = track.scrollWidth / 3;
      }

      function tick(now) {
        if (!running) { lastTime = now; requestAnimationFrame(tick); return; }
        if (!lastTime) lastTime = now;
        var dt = (now - lastTime) / 1000;
        lastTime = now;
        // cap dt to avoid huge jumps when tab is backgrounded
        if (dt > 0.1) dt = 0.016;
        offset += speed * dt;
        if (offset >= oneThird) offset -= oneThird;
        track.style.transform = 'translate3d(' + (-offset) + 'px, 0, 0)';
        requestAnimationFrame(tick);
      }

      // pause on hover (desktop)
      track.addEventListener('mouseenter', function() { running = false; });
      track.addEventListener('mouseleave', function() { running = true; });

      // re-measure on resize
      window.addEventListener('resize', measure);

      // start
      measure();
      requestAnimationFrame(tick);
    })();
  </script>
  </div>
</body>
</html>
