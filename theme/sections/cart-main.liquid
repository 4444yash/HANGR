<!-- ===== SHOPIFY CART PAGE SECTION ===== -->
<section class="cart-page-section" style="padding: 40px 20px 80px; max-width: 860px; margin: 0 auto; min-height: 65vh;">
  <div style="text-align: center; margin-bottom: 32px;">
    <h1 style="font-family: var(--font-heading); font-size: 2.2rem; font-weight: 700; margin-bottom: 8px; color: var(--dark);">Your Shopping Cart</h1>
    <p style="color: var(--gray-600); font-size: 0.95rem;">Review your selected HANGR items before proceeding to checkout.</p>
  </div>

  {% if cart.item_count > 0 %}
    <form action="{{ routes.cart_url }}" method="post" id="cart" class="cart-page-form" style="background: var(--white); border: 1px solid var(--gray-200); border-radius: 16px; padding: 24px; box-shadow: 0 4px 20px rgba(0,0,0,0.04);">
      <div class="cart-items-list" style="display: flex; flex-direction: column; gap: 20px; margin-bottom: 28px;">
        {% for item in cart.items %}
          <div class="cart-item-row" style="display: flex; align-items: center; gap: 16px; padding-bottom: 20px; border-bottom: 1px solid var(--gray-100);">
            <div style="width: 80px; height: 80px; flex-shrink: 0; background: var(--off-white); border-radius: 10px; overflow: hidden; border: 1px solid var(--gray-200);">
              {% if item.image %}
                <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}" style="width: 100%; height: 100%; object-fit: cover;">
              {% endif %}
            </div>

            <div style="flex: 1; min-width: 0;">
              <h3 style="font-size: 1rem; font-weight: 700; margin-bottom: 4px; color: var(--dark);">{{ item.product.title }}</h3>
              {% unless item.product.has_only_default_variant %}
                <p style="font-size: 0.85rem; color: var(--gray-600); margin-bottom: 6px;">{{ item.variant.title }}</p>
              {% endunless %}
              <div style="font-weight: 700; font-size: 0.95rem; color: var(--dark);">{{ item.final_price | money }}</div>
            </div>

            <div style="display: flex; align-items: center; gap: 8px;">
              <div style="display: flex; align-items: center; border: 1px solid var(--gray-300); border-radius: 8px; overflow: hidden; height: 36px;">
                <a href="/cart/change?line={{ forloop.index }}&quantity={{ item.quantity | minus: 1 }}" style="padding: 0 10px; font-size: 1.1rem; color: var(--dark); text-decoration: none; display: flex; align-items: center; justify-content: center; height: 100%; background: var(--off-white); cursor: pointer;">−</a>
                <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" style="width: 40px; text-align: center; border: none; font-weight: 600; font-size: 0.9rem; -moz-appearance: textfield;" readonly>
                <a href="/cart/change?line={{ forloop.index }}&quantity={{ item.quantity | plus: 1 }}" style="padding: 0 10px; font-size: 1.1rem; color: var(--dark); text-decoration: none; display: flex; align-items: center; justify-content: center; height: 100%; background: var(--off-white); cursor: pointer;">+</a>
              </div>
              <a href="/cart/change?line={{ forloop.index }}&quantity=0" title="Remove item" style="color: var(--red-accent, #ef4444); font-size: 1.4rem; padding: 4px 8px; text-decoration: none; cursor: pointer;">&times;</a>
            </div>
          </div>
        {% endfor %}
      </div>

      <div class="cart-summary-box" style="padding-top: 16px;">
        <div style="display: flex; justify-content: space-between; align-items: center; font-size: 1.25rem; font-weight: 800; color: var(--dark); margin-bottom: 8px;">
          <span>Subtotal</span>
          <span>{{ cart.total_price | money }}</span>
        </div>
        <p style="font-size: 0.8rem; color: var(--gray-600); margin-bottom: 20px; text-align: right;">Taxes & Free Express Shipping calculated at checkout</p>

        <!-- App Blocks placeholder (for CODKing or other app blocks) -->
        <div class="cart-app-blocks" style="margin-bottom: 16px;">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when '@app' -%}
                {% render block %}
            {%- endcase -%}
          {%- endfor -%}
        </div>

        <button type="submit" name="checkout" id="checkout" class="btn-primary btn-checkout" style="width: 100%; justify-content: center; text-align: center; border-radius: 50px; padding: 16px; font-size: 1.05rem; font-weight: 800; letter-spacing: 0.03em; cursor: pointer; border: none; background: var(--emerald, #059669); color: #fff;">
          PROCEED TO CHECKOUT →
        </button>
      </div>
    </form>
  {% else %}
    <div style="text-align: center; padding: 60px 20px; background: var(--white); border-radius: 16px; border: 1px solid var(--gray-200);">
      <p style="font-size: 1.2rem; font-weight: 600; margin-bottom: 20px; color: var(--gray-600);">Your cart is currently empty.</p>
      <a href="/#product-section" class="btn-primary" style="display: inline-flex; border-radius: 50px; padding: 14px 28px;">
        ← CONTINUE SHOPPING
      </a>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Cart Main",
  "tag": "div",
  "blocks": [
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
