  <div class="organizing__inner">
    <h2 class="organizing__title">Perfect For<br>Organizing</h2>
    <div class="organizing__items">
      <div class="organizing__item">
        <div class="organizing__item-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/></svg>
        </div>
        <span class="organizing__item-label">Bangles &<br>Bracelets</span>
      </div>
      <div class="organizing__item">
        <div class="organizing__item-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L8 8l-6 1 4.5 4L5 19l7-3.5L19 19l-1.5-6L22 9l-6-1z"/></svg>
