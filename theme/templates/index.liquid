        <div class="gallery__card-title">BRIDAL BANGLES</div>
        <div class="gallery__card-desc">Tangle-free & easy to pick</div>
      </div>
    </div>
    <div class="gallery__card fade-in fade-in-delay-2">
      <img src="{{ 'hair-accessories.png' | asset_url }}" alt="Hair accessories" loading="lazy" width="320" height="427">
      <div class="gallery__card-overlay">
        <div class="gallery__card-title">HAIR ACCESSORIES</div>
        <div class="gallery__card-desc">Store 30+ scrunchies easily</div>
      </div>
    </div>
    <div class="gallery__card fade-in fade-in-delay-3">
      <img src="{{ 'belts-watches.png' | asset_url }}" alt="Belts and watches" loading="lazy" width="320" height="427">
      <div class="gallery__card-overlay">
        <div class="gallery__card-title">BELTS & WATCHES</div>
        <div class="gallery__card-desc">No more tangled straps</div>
