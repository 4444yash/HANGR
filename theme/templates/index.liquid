{% assign main_product = all_products['multi-tier-cloth-bangle-steel-hanger'] %}
{% if main_product == blank or main_product.title == blank %}
  {% assign main_product = collections.all.products.first %}
{% endif %}

<!-- ===== HERO & PRODUCT PURCHASE SECTION (ABOVE THE FOLD) ===== -->
<section class="hero" id="hero">
  <div class="hero__inner">
    <!-- Left Column: Interactive Product Image Gallery -->
    <div class="product-gallery-container">
      <div class="product-gallery-main" id="gallery-main-wrapper">
        <button type="button" class="gallery-nav-btn gallery-nav-prev" onclick="prevGalleryImage(event)" aria-label="Previous Image">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>

        {% if main_product != blank and main_product.featured_image != blank %}
          <img
            id="main-product-display"
            src="{{ main_product.featured_image | image_url: width: 1600 }}"
            onerror="this.onerror=null; this.src='{{ 'hanger-hero.png' | asset_url }}';"
            alt="{{ main_product.title }}"
            loading="eager"
          >
        {% else %}
          <img
            id="main-product-display"
            src="{{ 'hanger-hero.png' | asset_url }}"
            onerror="this.onerror=null; this.src='{{ 'hanger-hero.png' | asset_url }}';"
            alt="Multi Tier Heavy Duty Steel Hanger"
            loading="eager"
          >
        {% endif %}

        <button type="button" class="gallery-nav-btn gallery-nav-next" onclick="nextGalleryImage(event)" aria-label="Next Image">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>
      </div>
      <div class="gallery-thumbs" id="gallery-thumbs-list">
        {% if main_product.images.size > 0 %}
          {% for img in main_product.images %}
            <img class="thumb-img {% if forloop.first %}active{% endif %}" src="{{ img | image_url: width: 300 }}" data-full-src="{{ img | image_url: width: 1600 }}" onerror="this.onerror=null; this.src='{{ 'hanger-hero.png' | asset_url }}';" onclick="switchMainImage(this)" alt="Hanger view {{ forloop.index }}">
          {% endfor %}
        {% else %}
          <img class="thumb-img active" src="{{ 'hanger-hero.png' | asset_url }}" data-full-src="{{ 'hanger-hero.png' | asset_url }}" onclick="switchMainImage(this)" alt="Studio Multi-Tier Hanger View">
          <img class="thumb-img" src="{{ 'hanger-swing-arms.png' | asset_url }}" data-full-src="{{ 'hanger-swing-arms.png' | asset_url }}" onclick="switchMainImage(this)" alt="Openable Swing Arm Detail">
          <img class="thumb-img" src="{{ 'hanger-closet-lifestyle.png' | asset_url }}" data-full-src="{{ 'hanger-closet-lifestyle.png' | asset_url }}" onclick="switchMainImage(this)" alt="Before & After Closet Space Saver">
          <img class="thumb-img" src="{{ 'hanger-hook-detail.png' | asset_url }}" data-full-src="{{ 'hanger-hook-detail.png' | asset_url }}" onclick="switchMainImage(this)" alt="Heavy Duty Anti-Scratch Hook">
          <img class="thumb-img" src="{{ 'hanger-dimensions-spec.png' | asset_url }}" data-full-src="{{ 'hanger-dimensions-spec.png' | asset_url }}" onclick="switchMainImage(this)" alt="Dimensions & Layer Spacing">
          <img class="thumb-img" src="{{ '8layer-hanger.jpeg' | asset_url }}" data-full-src="{{ '8layer-hanger.jpeg' | asset_url }}" onclick="switchMainImage(this)" alt="Real Product Photo">
          <img class="thumb-img" src="{{ 'IMG_1216.jpeg' | asset_url }}" data-full-src="{{ 'IMG_1216.jpeg' | asset_url }}" onclick="switchMainImage(this)" alt="Real Closet Setup Photo">
        {% endif %}
      </div>
    </div>

    <!-- Right Column: Native Shopify Product Buy Box -->
    <div class="hero__product-card" id="product-card">
      <div class="product-brand-tag">
        {{ main_product.vendor | default: 'HANGR' }} • Official Store
      </div>
      <h1 class="product-headline-title">
        {{ main_product.title | default: 'Multi-Tier Heavy Duty Stainless Steel Hanger (Pack of 2)' }}
      </h1>

      <div class="product-rating-row">
        <span class="stars-gold">★★★★★</span>
        <span style="font-weight: 700; color: var(--dark);">4.9 / 5.0</span>
        <span style="color: var(--gray-600);">(1,480+ Verified Buyer Reviews)</span>
      </div>

      <div class="product-price-box">
        <div class="price-main">
          <span class="price-current" id="product-price-display">
            {% if main_product.price %}
              {{ main_product.price | money }}
            {% else %}
              Rs. 499.00 - Rs. 849.00
            {% endif %}
          </span>
          <span class="price-mrp">M.R.P.: Rs. 1,499</span>
          <span class="price-discount-badge">Save 50% OFF</span>
        </div>
        <div class="coupon-callout">
          🔥 Extra 10% OFF with Code: <strong>HANGR10</strong> (Applied at checkout)
        </div>
      </div>

      <!-- Specs Highlights -->
      <div class="product-specs-list">
        <div class="spec-item" style="background: #ECFDF5; border-left: 3px solid #10B981; padding: 6px 10px; border-radius: 4px;">
          <span class="spec-icon" style="color: #059669;">🎁</span>
          <span style="color: #065F46;"><strong>PACK OF 2 INCLUDED</strong>: Double the storage! You get 2 full hangers in every order</span>
        </div>
        <div class="spec-item">
          <span class="spec-icon">✓</span>
          <span><strong>100% Stainless Steel</strong>: Anti-rust electroplated chrome finish</span>
        </div>
        <div class="spec-item">
          <span class="spec-icon">✓</span>
          <span><strong>Holds Up To 100+ Bangles / 15kg</strong>: Heavy duty, won't bend</span>
        </div>
        <div class="spec-item">
          <span class="spec-icon">✓</span>
          <span><strong>Compact 80% Space Saver</strong>: Organizes bangles, scrunchies, belts & jhumkas</span>
        </div>
        <div class="spec-item">
          <span class="spec-icon">✓</span>
          <span><strong>Smooth Anti-Scratch Edges</strong>: Safe for delicate glass & silk bangles</span>
        </div>
      </div>

      <!-- Native Shopify Product Form -->
      <form action="/cart/add" method="post" enctype="multipart/form-data" id="AddToCartForm">
        <div class="product-qty-selector">
          <label class="product-qty-label">Quantity</label>
          <div class="product-qty-controls">
            <button type="button" class="product-qty-btn" onclick="adjustProductQty(-1)">−</button>
            <input type="number" id="product-qty-input" name="quantity" value="1" min="1" class="product-qty-input" onchange="validateProductQty(this)">
            <button type="button" class="product-qty-btn" onclick="adjustProductQty(1)">+</button>
          </div>
        </div>


        <div style="margin-bottom: 18px;">
          <label style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; display: block; margin-bottom: 10px;">Select Size / Layers</label>
          <div style="display: flex; gap: 10px; flex-wrap: wrap;">
            {% if main_product.variants.size > 0 %}
              {% for variant in main_product.variants %}
                <label style="border: 2px solid {% if forloop.first %}var(--dark){% else %}var(--gray-200){% endif %}; border-radius: 8px; padding: 10px 16px; font-weight: 600; font-size: 0.85rem; cursor: pointer; background: {% if forloop.first %}#FDFBF7{% else %}var(--white){% endif %}; transition: all 0.2s ease;" class="variant-option-label {% if forloop.first %}active{% endif %}">
                  <input
                    type="radio"
                    name="id"
                    value="{{ variant.id }}"
                    data-price="{{ variant.price | money }}"
                    data-mrp="{{ variant.compare_at_price | default: variant.price | times: 2 | money }}"
                    onchange="updateVariantSelection(this)"
                    {% if forloop.first %}checked{% endif %}
                    style="margin-right: 6px;"
                  >
                  {{ variant.title }}{% unless variant.title contains 'Pack' %} (Pack of 2){% endunless %} — {{ variant.price | money }}
                </label>
              {% endfor %}
            {% else %}
              <!-- Fallback Shopify Variant IDs -->
              <label style="border: 2px solid var(--dark); border-radius: 8px; padding: 10px 16px; font-weight: 600; font-size: 0.85rem; cursor: pointer; background: #FDFBF7; transition: all 0.2s ease;" class="variant-option-label active">
                <input type="radio" name="id" value="53853852500152" data-price="Rs. 499.00" data-mrp="M.R.P.: Rs. 999" onchange="updateVariantSelection(this)" checked style="margin-right: 6px;">
                3 Layer (Pack of 2) — Rs. 499.00
              </label>
              <label style="border: 2px solid var(--gray-200); border-radius: 8px; padding: 10px 16px; font-weight: 600; font-size: 0.85rem; cursor: pointer; background: var(--white); transition: all 0.2s ease;" class="variant-option-label">
                <input type="radio" name="id" value="53853852532920" data-price="Rs. 579.00" data-mrp="M.R.P.: Rs. 1,199" onchange="updateVariantSelection(this)" style="margin-right: 6px;">
                4 Layer (Pack of 2) — Rs. 579.00
              </label>
              <label style="border: 2px solid var(--gray-200); border-radius: 8px; padding: 10px 16px; font-weight: 600; font-size: 0.85rem; cursor: pointer; background: var(--white); transition: all 0.2s ease;" class="variant-option-label">
                <input type="radio" name="id" value="53853852565688" data-price="Rs. 749.00" data-mrp="M.R.P.: Rs. 1,499" onchange="updateVariantSelection(this)" style="margin-right: 6px;">
                6 Layer (Pack of 2) — Rs. 749.00
              </label>
              <label style="border: 2px solid var(--gray-200); border-radius: 8px; padding: 10px 16px; font-weight: 600; font-size: 0.85rem; cursor: pointer; background: var(--white); transition: all 0.2s ease;" class="variant-option-label">
                <input type="radio" name="id" value="53853852598456" data-price="Rs. 849.00" data-mrp="M.R.P.: Rs. 1,699" onchange="updateVariantSelection(this)" style="margin-right: 6px;">
                8 Layer (Pack of 2) — Rs. 849.00
              </label>
            {% endif %}
          </div>
        </div>

        <div class="product-card__buttons">
          <button
            type="button"
            class="product-card__add-btn"
            onclick="handleAddToCart(event)"
          >ADD TO CART</button>
          <button
            type="button"
            class="product-card__buy-btn"
            onclick="handleBuyNow(event)"
          >BUY NOW (CASH ON DELIVERY AVAILABLE)</button>
        </div>
      </form>

      <div style="font-size: 0.78rem; color: var(--gray-600); text-align: center; display: flex; justify-content: center; gap: 16px; margin-top: 4px;">
        <span>📦 Cash On Delivery Available</span>
        <span>🚚 Free Shipping ₹999+</span>
        <span>🛡️ 100% Quality Assured</span>
      </div>
    </div>
  </div>
</section>

<!-- ===== PERFECT FOR ORGANIZING ===== -->
