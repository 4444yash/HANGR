<!-- ===== PRODUCT PURCHASE SECTION ===== -->
<section class="product-section" id="product-section">
  <div class="product-section__banner fade-in">
    <div class="product-section__banner-content">
      <div class="product-section__banner-label">Loved by Thousands</div>
      <h2 class="product-section__banner-headline">Join the Organizing Revolution!</h2>
      <p class="product-section__banner-subtitle">Choose your perfect hanger size and transform your space today.</p>
      <a href="#product-card" class="btn-primary" style="display:inline-flex;">
        SHOP NOW
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
    <div class="product-section__banner-media">
      <img
        src="https://cdn.shopify.com/s/files/1/0973/8836/3960/files/ChatGPTImageAug4_2026_07_34_43PM.png?v=1785853884"
        alt="Multi Tier Hanger organizing accessories" loading="lazy" width="400" height="360"
      >
    </div>
  </div>

  <!-- Live Shopify Product Card -->
  <div class="product-card-wrapper" id="product-card">
    <shopify-context type="product" handle="multi-tier-cloth-bangle-steel-hanger">
      <template>
        <div class="product-card-grid">
          <div class="product-card__media-area">
            <shopify-media width="560" height="560" query="product.selectedOrFirstAvailableVariant.image"></shopify-media>
          </div>
          <div class="product-card__details-area">
            <div class="product-card__vendor">
              <shopify-data query="product.vendor"></shopify-data>
            </div>
            <h2 class="product-card__title">
              <shopify-data query="product.title"></shopify-data>
            </h2>
            <div class="product-card__price">
              <shopify-money query="product.selectedOrFirstAvailableVariant.price"></shopify-money>
            </div>
            <div class="product-card__description">
              <shopify-data query="product.descriptionHtml"></shopify-data>
            </div>
            <shopify-variant-selector></shopify-variant-selector>
            <div class="product-card__buttons">
              <button
                class="product-card__add-btn"
                onclick="getElementById('main-cart').addLine(event).showModal();"
                shopify-attr--disabled="!product.selectedOrFirstAvailableVariant.availableForSale"
              >ADD TO CART</button>
              <button
                class="product-card__buy-btn"
                onclick="document.querySelector('shopify-store').buyNow(event)"
                shopify-attr--disabled="!product.selectedOrFirstAvailableVariant.availableForSale"
              >BUY NOW</button>
            </div>
          </div>
        </div>
      </template>
      <div shopify-loading-placeholder class="loading-placeholder">
        <div class="loading-spinner"></div>
        Loading product...
      </div>
    </shopify-context>
  </div>
</section>
