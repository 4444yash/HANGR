      <div class="gallery__card-overlay">
        <div class="gallery__card-title">JHUMKAS & EARRINGS</div>
        <div class="gallery__card-desc">Hang your heavy jewelry safely</div>
      </div>
    </div>
  </div>
</section>

<!-- ===== COMPARISON TABLE ===== -->
<section class="comparison-section" id="comparison-section">
  <div style="text-align: center;">
    <div class="section-label">WHY CHOOSE US</div>
    <h2 class="gallery__headline">HANGR vs Cheap Racks & Hooks</h2>
  </div>

  <div class="comparison-table">
    <div class="comparison-header">
      <div>Features</div>
      <div class="highlight-col">HANGR Steel Hanger</div>
      <div>Cheap Plastic Racks</div>
    </div>
    <div class="comparison-row">
      <div>100% Rust-Proof Stainless Steel</div>
      <div><span class="badge-check">✓</span></div>
      <div><span class="badge-cross">✕</span></div>
    </div>
    <div class="comparison-row">
      <div>Holds Heavy Load (Up to 15kg / 100+ Bangles)</div>
      <div><span class="badge-check">✓</span></div>
      <div><span class="badge-cross">✕</span> (Bends & Breaks)</div>
    </div>
    <div class="comparison-row">
      <div>Compact Wardrobe Space Saver</div>
      <div><span class="badge-check">✓</span></div>
      <div><span class="badge-cross">✕</span> (Bulky Racks)</div>
    </div>
    <div class="comparison-row">
      <div>Smooth Anti-Scratch Finish</div>
      <div><span class="badge-check">✓</span></div>
      <div><span class="badge-cross">✕</span></div>
    </div>
    <div class="comparison-row">
      <div>100% Rust-Free Guarantee</div>
      <div><span class="badge-check">✓</span></div>
      <div><span class="badge-cross">✕</span></div>
    </div>
  </div>
</section>

<!-- ===== CUSTOMER REVIEWS & PHOTO SUBMISSION ===== -->
<section class="reviews-section" id="reviews-section">
  <div class="reviews-header">
    <div>
      <div class="section-label">CUSTOMER FEEDBACK</div>
      <h2 class="gallery__headline" style="margin-bottom: 0;">Verified Buyer Reviews</h2>
    </div>

    <div class="reviews-summary">
      <div class="reviews-score">
        <div class="reviews-score__number">4.9</div>
        <div class="reviews-score__stars">★★★★★</div>
        <div class="reviews-score__count">Based on 1,480+ Indian Reviews</div>
      </div>

      <button class="btn-write-review" onclick="openReviewModal()">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
        Write a Review
      </button>
    </div>
  </div>

  <div class="reviews-grid" id="reviews-grid">
    <!-- Empty reviews notice ready for user submitted reviews -->
    <div id="empty-reviews-notice" style="grid-column: 1 / -1; text-align: center; padding: 48px 24px; color: var(--gray-600); background: #FDFBF7; border-radius: 16px; border: 1.5px dashed var(--gray-300);">
      <p style="font-size: 1.1rem; font-weight: 700; margin-bottom: 8px; color: var(--dark);">No customer reviews yet.</p>
      <p style="font-size: 0.88rem; margin-bottom: 20px; color: var(--gray-600);">Be the first to leave a review and share your product photos!</p>
      <button class="btn-primary" onclick="openReviewModal()" style="font-size: 0.85rem; padding: 12px 28px; border-radius: 50px; display: inline-flex; align-items: center; gap: 8px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
        Write the First Review
      </button>
    </div>
  </div>
</section>

<!-- ===== WRITE REVIEW MODAL ===== -->
<div class="modal-overlay" id="review-modal">
  <div class="modal-content">
    <span class="modal-close" onclick="closeReviewModal()">&times;</span>
    <h3 style="font-family: var(--font-heading); font-size: 1.5rem; margin-bottom: 8px;">Write a Customer Review</h3>
    <p style="font-size: 0.85rem; color: var(--gray-600); margin-bottom: 20px;">Share your experience with photos to help other buyers!</p>

    <form id="review-form" onsubmit="submitReview(event)">
      <div class="form-group">
        <label>Your Overall Rating</label>
        <div class="star-rating-select" id="star-picker">
          <span class="star selected" data-value="1">★</span>
          <span class="star selected" data-value="2">★</span>
          <span class="star selected" data-value="3">★</span>
          <span class="star selected" data-value="4">★</span>
          <span class="star selected" data-value="5">★</span>
        </div>
        <input type="hidden" id="review-rating-val" value="5">
      </div>

      <div class="form-group">
        <label>Your Name</label>
        <input type="text" id="review-name" class="form-input" placeholder="e.g. Kavita Patel" required>
      </div>

      <div class="form-group">
        <label>City / Location</label>
        <input type="text" id="review-city" class="form-input" placeholder="e.g. Ahmedabad, Gujarat" required>
      </div>

      <div class="form-group">
        <label>Review Headline</label>
        <input type="text" id="review-headline" class="form-input" placeholder="e.g. Amazing space saver for bangles!" required>
      </div>

      <div class="form-group">
        <label>Detailed Review</label>
        <textarea id="review-body" class="form-textarea" rows="3" placeholder="Tell us how you use HANGR in your home..." required></textarea>
      </div>

      <div class="form-group">
        <label>Upload Hanger Photo (Optional)</label>
        <input type="file" id="review-photo-input" accept="image/*" onchange="previewReviewPhoto(event)" class="form-input">
        <img id="photo-preview-img" class="photo-preview" alt="Preview">
      </div>

      <button type="submit" class="btn-primary" style="width: 100%; border-radius: 10px; margin-top: 10px;">
        SUBMIT REVIEW
      </button>
    </form>
  </div>
</div>

<!-- ===== 8. FAQ ACCORDION SECTION ===== -->
<section class="faq-section" id="faq-section">
  <div style="text-align: center;">
    <div class="section-label">HAVE QUESTIONS?</div>
    <h2 class="gallery__headline">Frequently Asked Questions</h2>
  </div>

  <div class="faq-container">
    <div class="faq-item active">
      <button class="faq-question" type="button">
        <span>Is Cash on Delivery (COD) available for my pincode?</span>
        <span class="faq-icon">▼</span>
      </button>
      <div class="faq-answer">
        Yes! We offer Cash on Delivery (COD) across 19,000+ pincodes all over India. You can pay cash at your doorstep when the delivery agent arrives.
      </div>
    </div>

    <div class="faq-item">
      <button class="faq-question" type="button">
        <span>How many bangles or items can one hanger hold?</span>
        <span class="faq-icon">▼</span>
      </button>
      <div class="faq-answer">
        Depending on the tier option (3, 4, 6, or 8 layers), one HANGR steel rack can hold up to 100+ bangles, 30+ hair scrunchies, 20+ leather belts, or heavy metallic jewelry effortlessly.
      </div>
    </div>

    <div class="faq-item">
      <button class="faq-question" type="button">
        <span>Will it rust or lose shine in humid weather?</span>
        <span class="faq-icon">▼</span>
      </button>
      <div class="faq-answer">
        No! HANGR is engineered from 100% premium grade stainless steel with multi-layer electroplated polish. It is 100% rust-proof and corrosion resistant even in high humidity coastal areas like Mumbai, Chennai, or Kolkata.
      </div>
    </div>

    <div class="faq-item">
      <button class="faq-question" type="button">
        <span>What is the estimated delivery time?</span>
        <span class="faq-icon">▼</span>
      </button>
      <div class="faq-answer">
        Orders dispatched within 24 hours. Delivery takes 3 to 5 working days depending on your location in India. Tracking link is provided via SMS & WhatsApp.
      </div>
    </div>
  </div>
</section>
