{% assign main_product = all_products['multi-tier-cloth-bangle-steel-hanger'] %}
{% if main_product == blank or main_product.title == blank %}
  {% assign main_product = collections.all.products.first %}
{% endif %}

<!-- ===== HERO & PRODUCT PURCHASE SECTION (ABOVE THE FOLD) ===== -->
<section class="hero" id="hero">
  <div class="hero__inner">
    <!-- Left Column: Interactive Product Image Gallery -->
    <div class="product-gallery-container">
      <div class="product-gallery-main">
        {% if main_product.featured_image %}
          <img
            id="main-product-display"
            src="{{ main_product.featured_image | image_url: width: 600 }}"
            alt="{{ main_product.title }}"
            width="560"
            height="560"
          >
        {% else %}
          <img
            id="main-product-display"
            src="https://cdn.shopify.com/s/files/1/0973/8836/3960/files/Gemini_Generated_Image_yu69ilyu69ilyu69.png?v=1785853884"
            alt="Multi Tier Steel Hanger"
            width="560"
            height="560"
          >
        {% endif %}
      </div>
      <div class="gallery-thumbs">
        {% if main_product.images.size > 0 %}
          {% for img in main_product.images limit: 5 %}
            <img class="thumb-img {% if forloop.first %}active{% endif %}" src="{{ img | image_url: width: 150 }}" onclick="switchMainImage(this)" alt="Hanger view {{ forloop.index }}">
          {% endfor %}
        {% else %}
          <img class="thumb-img active" src="https://cdn.shopify.com/s/files/1/0973/8836/3960/files/Gemini_Generated_Image_yu69ilyu69ilyu69.png?v=1785853884" onclick="switchMainImage(this)" alt="Bangles angle">
          <img class="thumb-img" src="{{ 'bangles.png' | asset_url }}" onclick="switchMainImage(this)" alt="Close up bangles">
          <img class="thumb-img" src="{{ 'hair-accessories.png' | asset_url }}" onclick="switchMainImage(this)" alt="Hair accessories">
          <img class="thumb-img" src="{{ 'belts-watches.png' | asset_url }}" onclick="switchMainImage(this)" alt="Belts watches">
          <img class="thumb-img" src="{{ 'earrings.png' | asset_url }}" onclick="switchMainImage(this)" alt="Jhumkas">
        {% endif %}
      </div>
    </div>

    <!-- Right Column: Native Shopify Product Buy Box -->
    <div class="hero__product-card" id="product-card">
      <div class="product-brand-tag">
        {{ main_product.vendor | default: 'HANGR' }} • Official Store
      </div>
      <h1 class="product-headline-title">
        {{ main_product.title | default: 'Multi-Tier Heavy Duty Stainless Steel Hanger Pack of 2' }}
      </h1>

      <div class="product-rating-row">
        <span class="stars-gold">★★★★★</span>
        <span style="font-weight: 700; color: var(--dark);">4.9 / 5.0</span>
        <span style="color: var(--gray-600);">(1,480+ Verified Buyer Reviews)</span>
      </div>

      <div class="product-price-box">
        <div class="price-main">
          <span class="price-current" id="product-price-display">
            {% if main_product.price %}
              {{ main_product.price | money }}
            {% else %}
              Rs. 499.00 - Rs. 849.00
            {% endif %}
          </span>
          <span class="price-mrp">M.R.P.: Rs. 1,499</span>
          <span class="price-discount-badge">Save 50% OFF</span>
        </div>
        <div class="coupon-callout">
          🔥 Extra 10% OFF with Code: <strong>HANGR10</strong> (Applied at checkout)
        </div>
      </div>

      <!-- Specs Highlights -->
      <div class="product-specs-list">
        <div class="spec-item">
          <span class="spec-icon">✓</span>
          <span><strong>100% Stainless Steel</strong>: Anti-rust electroplated chrome finish</span>
        </div>
        <div class="spec-item">
          <span class="spec-icon">✓</span>
          <span><strong>Holds Up To 100+ Bangles / 15kg</strong>: Heavy duty, won't bend</span>
        </div>
        <div class="spec-item">
          <span class="spec-icon">✓</span>
          <span><strong>Compact 80% Space Saver</strong>: Organizes bangles, scrunchies, belts & jhumkas</span>
        </div>
        <div class="spec-item">
          <span class="spec-icon">✓</span>
          <span><strong>Smooth Anti-Scratch Edges</strong>: Safe for delicate glass & silk bangles</span>
        </div>
        <div class="spec-item">
          <span class="spec-icon">✓</span>
          <span><strong>Fast 3-5 Days Express Shipping</strong> across 19,000+ Pincodes in India</span>
        </div>
      </div>

      <!-- Native Shopify Product Form -->
      <form action="/cart/add" method="post" enctype="multipart/form-data" id="AddToCartForm">
        <input type="hidden" name="quantity" value="1">

        <div style="margin-bottom: 18px;">
          <label style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; display: block; margin-bottom: 10px;">Select Size / Layers</label>
          <div style="display: flex; gap: 10px; flex-wrap: wrap;">
            {% if main_product.variants.size > 0 %}
              {% for variant in main_product.variants %}
                <label style="border: 2px solid var(--gray-200); border-radius: 8px; padding: 10px 16px; font-weight: 600; font-size: 0.85rem; cursor: pointer; background: var(--white); transition: all 0.2s ease;" class="variant-option-label">
                  <input
                    type="radio"
                    name="id"
                    value="{{ variant.id }}"
                    {% if forloop.first %}checked{% endif %}
                    style="margin-right: 6px;"
                  >
                  {{ variant.title }} — {{ variant.price | money }}
                </label>
              {% endfor %}
            {% else %}
              <!-- Fallback Shopify Variant IDs -->
              <label style="border: 2px solid var(--gray-200); border-radius: 8px; padding: 10px 16px; font-weight: 600; font-size: 0.85rem; cursor: pointer; background: var(--white);" class="variant-option-label">
                <input type="radio" name="id" value="53853852500152" checked style="margin-right: 6px;">
                3 Layer — Rs. 499.00
              </label>
              <label style="border: 2px solid var(--gray-200); border-radius: 8px; padding: 10px 16px; font-weight: 600; font-size: 0.85rem; cursor: pointer; background: var(--white);" class="variant-option-label">
                <input type="radio" name="id" value="53853852532920" style="margin-right: 6px;">
                4 Layer — Rs. 579.00
              </label>
              <label style="border: 2px solid var(--gray-200); border-radius: 8px; padding: 10px 16px; font-weight: 600; font-size: 0.85rem; cursor: pointer; background: var(--white);" class="variant-option-label">
                <input type="radio" name="id" value="53853852565688" style="margin-right: 6px;">
                6 Layer — Rs. 749.00
              </label>
              <label style="border: 2px solid var(--gray-200); border-radius: 8px; padding: 10px 16px; font-weight: 600; font-size: 0.85rem; cursor: pointer; background: var(--white);" class="variant-option-label">
                <input type="radio" name="id" value="53853852598456" style="margin-right: 6px;">
                8 Layer — Rs. 849.00
              </label>
            {% endif %}
          </div>
        </div>

        <div class="product-card__buttons">
          <button
            type="button"
            class="product-card__add-btn"
            onclick="handleAddToCart(event)"
          >ADD TO CART</button>
          <button
            type="button"
            class="product-card__buy-btn"
            onclick="handleBuyNow(event)"
          >BUY NOW (CASH ON DELIVERY AVAILABLE)</button>
        </div>
      </form>

      <div style="font-size: 0.78rem; color: var(--gray-600); text-align: center; display: flex; justify-content: center; gap: 16px; margin-top: 4px;">
        <span>📦 Cash On Delivery Available</span>
        <span>🚚 Free Shipping ₹999+</span>
        <span>🛡️ 7-Day Replacement</span>
      </div>
    </div>
  </div>
</section>

